# --- Required ---
ANTHROPIC_API_KEY=sk-ant-...
JWT_SECRET=generate-a-long-random-string

# --- Database (sqlite by default; use Postgres in production) ---
DATABASE_URL=sqlite:///./ats.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Frontend URL (used for CORS) ---
FRONTEND_URL=https://yourdomain.com

# --- Razorpay (only needed once you turn on payments) ---
RAZORPAY_KEY_ID=rzp_live_or_test_...
RAZORPAY_KEY_SECRET=...

# --- Pricing / quotas ---
PLAN_PRICE_INR=350
PLAN_VALIDITY_DAYS=30
PLAN_MODIFY_QUOTA=100
PLAN_DOWNLOAD_QUOTA=20

TOPUP_PRICE_INR=150
TOPUP_MODIFY_QUOTA=50
TOPUP_DOWNLOAD_QUOTA=10

# --- Optional: override model ---
ANTHROPIC_MODEL=claude-sonnet-4-6
